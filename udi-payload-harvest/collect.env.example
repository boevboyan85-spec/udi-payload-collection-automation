# Copy to `collect.env` in this directory (gitignored) and adjust.
# Keys here overwrite the same variables in the environment (so UDIBROWSERS in
# this file wins over a stale export from ~/.bashrc or setup scripts). Set
# UDI_COLLECT_ENV_OVERRIDE=0 to only fill unset variables. UDI_COLLECT_ENV=path
# selects another file (absolute or relative to project root).
#
# UDI_COLLECT_ENV=.env.collect

UDIBROWSERS=chrome,chromium,firefox,tor,brave
# true = use CHROME_DESKTOP_FILE for the Chrome binary; automation signals stay stock Playwright
CHROME_SIMULATE_REAL_USER=false
# With CHROME_SIMULATE_REAL_USER=1 and no CHROME_USER_DATA_DIR: pick best Chrome profile (incl. Snap/Flatpak) and mirror
# CHROME_SIMULATE_AUTO_PROFILE=1
# After adding extensions in normal Chrome: quit Chrome, then once CHROME_PROFILE_REFRESH_MIRROR=1 to refresh the mirror
# CHROME_NO_AUTO_REMIRROR_ON_STALE=1   # disable automatic re-copy when mirror has fewer extensions than live profile
DISABLE_PLUGINS=false

# Chrome user-data (extensions). Default path is auto-mirrored to ~/.config/udi-payload-harvest/chrome-playwright-mirror/
# CHROME_USER_DATA_DIR=/home/kasm-user/.config/google-chrome
# CHROME_PROFILE_REFRESH_MIRROR=1   # after installing extensions in normal Chrome; quit Chrome before re-copy

# Headless (no UI): applies to Chrome, Chromium, Brave, Opera, Firefox, WebKit; Tor uses Selenium headless.
# HEADLESS=1
