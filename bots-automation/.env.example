# Copy to ".env" and adjust. See README.md for full documentation.
# cp .env.example .env

# ---------------------------------------------------------------------------
# Local collector (when COLLECTOR_URL is not set, default URL is built from host:port)
# ---------------------------------------------------------------------------
# COLLECTOR_URL=
COLLECTOR_HOST=127.0.0.1
COLLECTOR_PORT=7778
COLLECTOR_PAGE_DIR=collector-page

# ---------------------------------------------------------------------------
# Collection run
# ---------------------------------------------------------------------------
# PAYLOAD_ELEMENT_ID=textareaPayload
PAYLOAD_TIMEOUT_MS=180000
# TestCafe (optional; Firefox headed is slow — extra wait applied automatically)
# TESTCAFE_PAYLOAD_TIMEOUT_MS=300000
# TESTCAFE_FIREFOX_HEADED_EXTRA_MS=120000
# TESTCAFE_PAGE_LOAD_TIMEOUT_MS=180000
# TESTCAFE_BROWSER_INIT_TIMEOUT_MS=180000
# PUPPETEER_NAVIGATION_TIMEOUT_MS=180000
# PUPPETEER_BROWSER_CLOSE_TIMEOUT_MS=20000
# Chrome only (do not use for Firefox — use FIREFOX_BIN / PUPPETEER_FIREFOX_EXECUTABLE_PATH)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
# PUPPETEER_FIREFOX_EXECUTABLE_PATH=
CSV_PATH=results/payloads.csv

# BOTS_COLLECT_DUAL=true
# BOTS_HEADLESS=true
# PUPPETEER_HEADLESS=
# PLAYWRIGHT_HEADLESS=
# SELENIUM_HEADLESS=
# TESTCAFE_HEADLESS=
# Platform: auto | macos | ubuntu | kasm | linux | win32 | windows  (auto-detects OS)
# BOTS_PLATFORM=auto
# Kasm/Docker: set ubuntu + container flags
# BOTS_PLATFORM=ubuntu
# BOTS_IN_CONTAINER=1
# BOTS_NO_SANDBOX=1
# Windows: Chrome + Edge + Firefox × all tools × headless/headed
# BOTS_PLATFORM=win32
# BOTS_COLLECT_DUAL=true
# PUPPETEER_SKIP_DOWNLOAD=1
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# CHROME_BIN=C:\Program Files\Google\Chrome\Application\chrome.exe
# EDGE_BIN=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
# FIREFOX_BIN=C:\Program Files\Mozilla Firefox\firefox.exe
# Playwright Firefox uses the Playwright bundle (npm run install:browsers), not FIREFOX_BIN.
# PLAYWRIGHT_FIREFOX_EXECUTABLE_PATH=
# BOTS_SKIP_OS_BROWSER_INSTALL=1
# BOTS_SKIP_SELENIUM_SAFARI=
# Browser binaries (optional overrides)
# CHROME_BIN=/usr/bin/google-chrome-stable
# Chromium (skip Ubuntu snap stub; Playwright cache is used if unset)
# CHROMIUM_BIN=$HOME/.cache/ms-playwright/chromium-*/chrome-linux/chrome
# FIREFOX_BIN=/usr/bin/firefox
# Microsoft Edge (TestCafe/Selenium/Playwright). Ubuntu package is microsoft-edge-stable.
# EDGE_BIN=/usr/bin/microsoft-edge-stable
# SELENIUM_SAFARI_SERVER=http://127.0.0.1:4444

# ---------------------------------------------------------------------------
# Risk service & reports (paths relative to project root)
# ---------------------------------------------------------------------------
RISK_SERVICE_URL=http://localhost:8080/v1/risk/signals
RISK_REQUEST_IP=185.212.107.9
# Optional JSON merged into every risk request httpHeaders (e.g. extra client hints)
# RISK_HTTP_HEADERS_JSON=

# Input CSV for report:* scripts (defaults to CSV_PATH if unset)
# CSV_INPUT=results/payloads.csv

RISK_REPORT_MD=results/risk-report.md
RISK_REPORT_JSON=results/risk-report-data.json
RISK_REPORT_MATRIX_MD=results/risk-report-isbot-matrix.md
RISK_REPORT_MATRIX_PDF=results/risk-report-isbot-matrix.pdf

IDENTIFIERS_REPORT_MD=results/identifiers-report.md
IDENTIFIERS_REPORT_JSON=results/identifiers-report.json
IDENTIFIERS_CELL_MAX_CHARS=8192

RISK_INDICATORS_REPORT_MD=results/risk-indicators-report.md
RISK_INDICATORS_REPORT_JSON=results/risk-indicators-report.json
RISK_INDICATORS_CELL_MAX_CHARS=8192

# ---------------------------------------------------------------------------
# PDF (md-to-pdf / Chromium)
# ---------------------------------------------------------------------------
# MD_TO_PDF_NO_SANDBOX=0
# CI=true
